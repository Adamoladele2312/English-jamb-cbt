*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:#eef3f8;
  color:#222;
}

#app{
  max-width:1100px;
  margin:25px auto;
  padding:20px;
}

.card{
  background:#fff;
  border-radius:10px;
  padding:25px;
  box-shadow:0 4px 10px rgba(0,0,0,.15);
}

h1{
  color:#003366;
  margin-bottom:15px;
}

h2{
  margin:15px 0;
}

input{
  width:100%;
  padding:12px;
  font-size:16px;
  border:1px solid #ccc;
  border-radius:6px;
  margin:12px 0;
}

button{
  background:#0055aa;
  color:white;
  border:none;
  padding:12px 20px;
  border-radius:6px;
  cursor:pointer;
  font-size:16px;
}

button:hover{
  background:#003d80;
}

.hidden{
  display:none;
}

@media(max-width:700px){

#app{
margin:10px;
padding:10px;
}

.card{
padding:18px;
}

}